diff --git a/csi-node-driver-registrar/2.17.0/rockcraft.yaml b/csi-node-driver-registrar/2.17.0/rockcraft.yaml
index 5e026b4..48def58 100644
--- a/csi-node-driver-registrar/2.17.0/rockcraft.yaml
+++ b/csi-node-driver-registrar/2.17.0/rockcraft.yaml
@@ -23,6 +23,7 @@ build-base: ubuntu@24.04
 platforms:
   amd64:
   arm64:
+  riscv64:
 
 environment:
   APP_VERSION: 2.17.0
@@ -59,11 +60,17 @@ parts:
   openssl:
     plugin: nil
     stage-packages:
-      - openssl-fips-module-3 # a Pro only FIPS package for openssl
       - openssl # now automatically selected from fips-preview
+      # A Pro only FIPS package for openssl. The Ubuntu Pro fips-updates
+      # archive does not provide it for riscv64.
+      - on riscv64: []
+      - else:
+          - openssl-fips-module-3
   csi-node-driver-registrar:
     after: [pebble]
     plugin: go
+    build-snaps:
+      - go/1.26-fips/stable
     source-type: git
     source: https://github.com/kubernetes-csi/node-driver-registrar.git
     source-tag: v${CRAFT_PROJECT_VERSION}

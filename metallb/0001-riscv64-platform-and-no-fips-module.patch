diff --git a/frr-k8s/v0.0.25/rockcraft.yaml b/frr-k8s/v0.0.25/rockcraft.yaml
index 5297e2a..a508d55 100644
--- a/frr-k8s/v0.0.25/rockcraft.yaml
+++ b/frr-k8s/v0.0.25/rockcraft.yaml
@@ -11,6 +11,7 @@ build-base: ubuntu@22.04
 platforms:
   amd64:
   arm64:
+  riscv64:
 
 entrypoint-service: frr-k8s
 services:
@@ -23,7 +24,10 @@ parts:
   openssl:
     plugin: nil
     stage-packages:
-      - openssl-fips-module-3
+      # Ubuntu Pro only; the fips-updates archive has no riscv64.
+      - on riscv64: []
+      - else:
+          - openssl-fips-module-3
       - openssl
 
   # The frr-k8s chart init containers run `/bin/sh -c "cp -f ..."`
@@ -43,7 +47,12 @@ parts:
     source-tag: v0.0.25
     source-depth: 1
     override-build: |
-      snap refresh go --channel 1.25-fips/stable
+      # The 1.25-fips channel does not exist on riscv64.
+      GO_CHANNEL=1.25-fips/stable
+      if [ "$CRAFT_ARCH_BUILD_FOR" = "riscv64" ]; then
+        GO_CHANNEL=1.26-fips/stable
+      fi
+      snap refresh go --channel "$GO_CHANNEL"
 
       GIT_COMMIT=`git rev-parse HEAD`
       # We'll use the tag name.
